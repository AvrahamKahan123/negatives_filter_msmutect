# Filter the recovered files in unread/ into filtered/, one condor job per sample.
#   <work_root>/unread/$(sample)...  ->  <work_root>/filtered/$(sample)...
#
#   python -m run_msmutect_over_whole_tcga_again.filter_unread --list jobs/filter_unread.txt
#   condor_submit filter_unread.sub
#
# Only worth using over the plain serial run when a lot of files were recovered: each job
# streams a whole ~27.7M-row file, so a few hundred of them take hours in sequence.
#
# After this, those samples are indistinguishable from the ones that filtered normally --
# re-run make_job_lists --step 2 and they flow into the rest of the pipeline on their own.

universe     = vanilla
getenv       = true
ShouldTransferFiles = No
initialdir   = .

executable   = run_job.sh
arguments    = filter_unread $(sample)

log    = $ENV(WORK_ROOT:/storage/bfe_maruvka/avrahamk/run_over_whole_tcga_again)/logs/filter_unread/$(sample).log
output = $ENV(WORK_ROOT:/storage/bfe_maruvka/avrahamk/run_over_whole_tcga_again)/logs/filter_unread/$(sample).out
error  = $ENV(WORK_ROOT:/storage/bfe_maruvka/avrahamk/run_over_whole_tcga_again)/logs/filter_unread/$(sample).err

RequestMemory = 1GB
request_cpus  = 1

# these read from unread/ on the LOCAL storage, not the troubled source tree, so they are
# gentler than step 1 -- but still keep a lid on it
max_materialize = 100

queue sample from jobs/filter_unread.txt
