# Step 1: keep only CALL=="M" rows.
#   <input_dir>/$(sample).full.mut.tsv.gz -> <work_root>/filtered/$(sample).full.mut.tsv.gz
#
#   python -m run_msmutect_over_whole_tcga_again.make_job_lists --step 1
#   condor_submit step1_filter.sub
#
# Streams the input, so memory is flat regardless of file size.

universe     = vanilla
getenv       = true
ShouldTransferFiles = No
initialdir   = .

executable   = run_job.sh
arguments    = filter_to_mutations $(sample)

log    = $ENV(WORK_ROOT:/storage/bfe_maruvka/avrahamk/run_over_whole_tcga_again)/logs/step1/$(sample).log
output = $ENV(WORK_ROOT:/storage/bfe_maruvka/avrahamk/run_over_whole_tcga_again)/logs/step1/$(sample).out
error  = $ENV(WORK_ROOT:/storage/bfe_maruvka/avrahamk/run_over_whole_tcga_again)/logs/step1/$(sample).err

RequestMemory = 1GB
request_cpus  = 1

# Cap how many jobs are in flight at once (idle + running). Without it condor queues the
# whole list and runs as many as the pool will give you.
#
# NOTE these jobs all stream large .gz files off the SAME filesystem
# (/storage/bfe_maruvka/gaiafr/...), the one that has been returning Input/output errors.
# 300 concurrent readers is a lot of pressure on it -- if the EIO count climbs when you
# raise this, lower it. Start smaller and work up.
max_materialize = 300

queue sample from jobs/step1_filter.txt
